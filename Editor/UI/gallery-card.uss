/* Gallery cards shared by MCB's asset gallery and My Avatar's asset gallery: a square picture over a short body.
   CardGrid sizes them to fill the row; these are the defaults before it runs. */
.orb-gallery-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; justify-content: center; min-width: 0; }
.orb-card { width: 174px; height: 267px; margin-left: 8px; margin-right: 8px; margin-bottom: 16px; background-color: #191919; border-radius: 18px; overflow: hidden; flex-shrink: 0; cursor: link; }
.orb-card:hover { background-color: #242424; }
.orb-card__media { height: 172px; background-color: #141414; border-top-left-radius: 18px; border-top-right-radius: 18px; overflow: hidden; }
.orb-card__media--create { height: 168px; background-color: #101010; justify-content: center; align-items: center; }
.orb-card__thumbnail { flex-grow: 1; }
.orb-card__body { flex-grow: 1; padding: 14px 14px 9px 14px; }
.orb-card__title-row { flex-direction: row; align-items: flex-start; }
.orb-card__title { flex-grow: 1; white-space: nowrap; overflow: hidden; font-size: 13px; color: #ffffff; -unity-font-style: bold; }
.orb-card__metrics { flex-direction: column; align-items: flex-end; margin-left: 8px; }
.orb-card__metric-row { flex-direction: row; align-items: center; justify-content: flex-end; height: 20px; }
.orb-card__metric-label { color: #ffffff; font-size: 11px; margin-right: 4px; }
.orb-card__metric-icon { width: 14px; height: 14px; }
.orb-card__spacer { flex-grow: 1; }
.orb-card__owner { flex-direction: row; align-items: center; margin-top: 10px; }
.orb-card__avatar { width: 22px; height: 22px; border-radius: 11px; background-color: #3d3d3d; overflow: hidden; }
.orb-card__avatar-image { width: 100%; height: 100%; min-width: 100%; min-height: 100%; flex-grow: 0; flex-shrink: 0; }
.orb-card__owner-name { margin-left: 10px; flex-grow: 1; white-space: nowrap; overflow: hidden; font-size: 12px; color: #ffffff; -unity-font-style: bold; }
.orb-create-card__body { flex-grow: 1; justify-content: center; align-items: center; padding-left: 18px; padding-right: 18px; }
.orb-create-card__plus { color: #ffffff; font-size: 52px; -unity-font-style: bold; }
.orb-create-card__label { white-space: normal; -unity-text-align: middle-center; font-size: 13px; color: #ffffff; -unity-font-style: bold; }
