.orbiters-icon-button { flex-grow: 1; flex-basis: 0; min-width: 72px; height: 64px; padding: 8px 4px 6px 4px; border-radius: 14px; background-color: #2c2c2c; align-items: center; justify-content: center; cursor: link; transition-property: background-color, scale; transition-duration: 0.12s; }
.orbiters-icon-button:hover { background-color: #363636; }
.orbiters-icon-button:focus { border-width: 1px; border-color: rgba(0, 218, 109, 0.45); }
.orbiters-icon-button--pressed { scale: 0.96 0.96; }
.orbiters-icon-button__icon { width: 24px; height: 24px; flex-shrink: 0; --icon-color: #d6d6d6; }
.orbiters-icon-button__label { margin: 5px 0 0 0; padding: 0; font-size: 11px; color: #c8c8c8; -unity-text-align: middle-center; white-space: nowrap; }
.orbiters-icon-button--on { background-color: #00DA6D; }
.orbiters-icon-button--on:hover { background-color: #19e27d; }
.orbiters-icon-button--on .orbiters-icon-button__icon { --icon-color: #06140c; }
.orbiters-icon-button--on .orbiters-icon-button__label { color: #06140c; -unity-font-style: bold; }
.orbiters-icon-button:disabled { opacity: 0.4; }

/* Compact round icon-only variant, e.g. a refresh button in a header. */
.orbiters-icon-button--small { flex-grow: 0; flex-basis: auto; min-width: 0; width: 26px; height: 26px; padding: 0; border-radius: 13px; background-color: rgba(0, 0, 0, 0); }
.orbiters-icon-button--small:hover { background-color: #333333; }
.orbiters-icon-button--small .orbiters-icon-button__icon { width: 16px; height: 16px; --icon-color: #9a9a9a; }
.orbiters-icon-button--small:hover .orbiters-icon-button__icon { --icon-color: #ffffff; }
.orbiters-icon-button--small .orbiters-icon-button__label { display: none; }

/* Inspector lock in the corner of a tool's header. */
.orbiters-inspector-lock { position: absolute; top: 6px; right: 6px; }
.orbiters-inspector-lock.orbiters-icon-button--on { background-color: rgba(0, 218, 109, 0.18); }
.orbiters-inspector-lock.orbiters-icon-button--on .orbiters-icon-button__icon { --icon-color: #00DA6D; }
