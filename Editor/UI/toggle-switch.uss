.orb-switch { width: 38px; height: 22px; flex-shrink: 0; border-radius: 11px; background-color: #4a4a4a; cursor: link; transition-property: background-color; transition-duration: 0.16s; }
.orb-switch:hover { background-color: #555555; }
.orb-switch:focus { border-width: 1px; border-color: rgba(0, 218, 109, 0.5); }
.orb-switch__knob { position: absolute; left: 3px; top: 3px; width: 16px; height: 16px; border-radius: 8px; background-color: #ffffff; transition-property: translate; transition-duration: 0.16s; transition-timing-function: ease-out-cubic; }
.orb-switch--on { background-color: #00DA6D; }
.orb-switch--on:hover { background-color: #19e27d; }
.orb-switch--on .orb-switch__knob { translate: 16px 0; }
.orb-switch:disabled { opacity: 0.4; }
