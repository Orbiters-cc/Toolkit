.orbiters-shape-search { width: auto; max-width: none; align-self: stretch; margin-top: 8px; margin-bottom: 10px; height: 34px; min-height: 34px; align-items: center; padding: 0 6px; background-image: none; background-color: #383838; border-width: 1px; border-color: #626262; border-radius: 5px; }
.orbiters-shape-search .unity-text-field__input {
    background-color: transparent; background-image: none; color: #eeeeee;
    border-width: 0; border-radius: 4px;
    padding: 5px 8px; min-height: 28px;
}
.orbiters-shape-search .unity-text-field__input:focus { background-color: #414141; }
.orbiters-shape-suggestions { flex-direction: row; flex-wrap: wrap; min-width: 0; margin-bottom: 8px; }
.orbiters-shape-suggestion { margin-left: 0; margin-right: 6px; margin-bottom: 6px; padding: 5px 9px; max-width: 100%; white-space: normal; border-radius: 5px; background-image: none; background-color: #494949; color: #eeeeee; border-width: 1px; border-color: #494949; }
.orbiters-shape-suggestion:hover { background-color: #575757; border-color: #666666; }
.orbiters-shape-suggestion:active { background-color: #626262; }
.orbiters-shape-suggestion--selected { border-color: #00da6d; background-color: #234b37; }
.orbiters-shape-toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
.orbiters-shape-count { flex-grow: 1; color: #bbbbbb; margin-right: 8px; }
.orbiters-shape-results { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; min-width: 0; margin-bottom: 8px; }
.orbiters-shape-scroll { max-height: 220px; flex-shrink: 0; margin-bottom: 8px; }
.orbiters-selection-scroll { max-height: 88px; flex-shrink: 0; }
.orbiters-shape-row { flex-shrink: 0; -unity-text-align: middle-left; transition-property: background-color, border-color; transition-duration: 0.12s; }
.orbiters-shape-action { height: 24px; margin-left: 6px; background-image: none; background-color: #494949; color: #dddddd; border-width: 0; border-radius: 8px; padding: 2px 12px; }
.orbiters-shape-action:hover { background-color: #5a5a5a; }
.orbiters-shape-action:disabled { opacity: 0.45; }
.orbiters-help { color: #999999; font-size: 11px; white-space: normal; margin-top: 4px; margin-bottom: 10px; }
