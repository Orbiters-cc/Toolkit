.orbiters-shape-search { width: auto; max-width: none; align-self: stretch; margin-top: 8px; margin-bottom: 10px; height: 34px; min-height: 34px; align-items: center; padding: 0 6px; background-image: none; background-color: #383838; border-width: 1px; border-color: #626262; border-radius: 5px; }
.orbiters-shape-search .unity-text-field__input {
    background-color: transparent; background-image: none; color: #eeeeee;
    border-width: 0; border-radius: 4px;
    padding: 5px 8px; min-height: 28px;
}
.orbiters-shape-search .unity-text-field__input:focus { background-color: #414141; }
.orbiters-shape-suggestions { flex-direction: row; flex-wrap: wrap; min-width: 0; margin-bottom: 8px; }
.orbiters-shape-suggestion { margin-left: 0; margin-right: 6px; margin-bottom: 6px; padding: 5px 9px; max-width: 100%; white-space: normal; border-radius: 5px; background-image: none; background-color: #494949; color: #eeeeee; border-width: 1px; border-color: #494949; }
.orbiters-shape-suggestion:hover { background-color: #575757; border-color: #666666; }
.orbiters-shape-suggestion:active { background-color: #626262; }
.orbiters-shape-suggestion--selected { border-color: #00da6d; background-color: #234b37; }
.orbiters-shape-toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
.orbiters-shape-count { flex-grow: 1; color: #bbbbbb; margin-right: 8px; }
.orbiters-shape-results { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; min-width: 0; margin-bottom: 8px; }
.orbiters-shape-scroll { max-height: 220px; flex-shrink: 0; margin-bottom: 8px; }
.orbiters-selection-scroll { max-height: 88px; flex-shrink: 0; }
.orbiters-shape-row { flex-shrink: 0; -unity-text-align: middle-left; transition-property: background-color, border-color; transition-duration: 0.12s; }
.orbiters-shape-action { height: 24px; margin-left: 6px; background-image: none; background-color: #494949; color: #dddddd; border-width: 0; border-radius: 8px; padding: 2px 12px; }
.orbiters-shape-action:hover { background-color: #5a5a5a; }
.orbiters-shape-action:disabled { opacity: 0.45; }
.orbiters-help { color: #999999; font-size: 11px; white-space: normal; margin-top: 4px; margin-bottom: 10px; }

/* Flat, for windows in the Orbiters look (ReFit, Substance Painter): round search, pills, no borders. */
.orbiters-shape-picker--flat .orbiters-shape-search { margin: 0 0 10px 0; height: 30px; min-height: 30px; padding: 0 4px; border-width: 0; border-radius: 15px; background-color: #2c2c2c; }
.orbiters-shape-picker--flat .orbiters-shape-search .unity-text-field__input { min-height: 24px; padding: 3px 8px; border-radius: 12px; color: #e6e6e6; font-size: 11px; }
.orbiters-shape-picker--flat .orbiters-shape-search .unity-text-field__input:focus { background-color: #333333; }
.orbiters-shape-picker--flat .unity-toolbar-search-field__search-button, .orbiters-shape-picker--flat .unity-search-field-base__search-button { margin-left: 6px; opacity: 0.6; }
.orbiters-shape-picker--flat .orbiters-shape-toolbar { margin-bottom: 8px; }
.orbiters-shape-picker--flat .orbiters-shape-count { margin: 0 8px 0 2px; padding: 0; color: #8f8f8f; font-size: 11px; }
.orbiters-shape-picker--flat .orbiters-shape-action { height: 24px; min-height: 24px; margin: 0 0 0 6px; padding: 0 10px; border-width: 0; border-radius: 6px; background-color: rgba(255, 255, 255, 0.06); color: #d0d0d0; font-size: 11px; transition-property: background-color, scale; transition-duration: 0.12s, 0.18s; }
.orbiters-shape-picker--flat .orbiters-shape-action:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.orbiters-shape-picker--flat .orbiters-shape-action:active { scale: 0.96 0.96; }
.orbiters-shape-picker--flat .orbiters-shape-suggestion { height: 24px; min-height: 24px; margin: 0 4px 4px 0; padding: 0 10px; border-width: 0; border-radius: 12px; background-color: #2e2e2e; color: #d0d0d0; font-size: 11px; white-space: nowrap; transition-property: background-color, scale; transition-duration: 0.12s, 0.18s; }
.orbiters-shape-picker--flat .orbiters-shape-suggestion:hover { background-color: #363636; color: #ffffff; }
.orbiters-shape-picker--flat .orbiters-shape-suggestion:active { scale: 0.95 0.95; background-color: #3a3a3a; }
.orbiters-shape-picker--flat .orbiters-shape-suggestion--selected, .orbiters-shape-picker--flat .orbiters-shape-suggestion--selected:hover { background-color: rgba(0, 218, 109, 0.14); color: #00DA6D; }
.orbiters-shape-picker--flat .orbiters-shape-scroll { margin-bottom: 6px; }
.orbiters-shape-picker--flat .orbiters-selection-scroll { padding-top: 8px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.orbiters-shape-picker--flat .orbiters-help { margin: 2px 2px 8px 2px; color: #8f8f8f; }
.orbiters-shape-picker--flat .unity-scroller--vertical { width: 6px; }
