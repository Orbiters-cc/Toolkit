.orb-stage { align-self: center; flex-shrink: 0; height: 15px; margin: 0 0 0 6px; padding: 0 6px; border-radius: 8px; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 0.3px; white-space: nowrap; }
.orb-stage--beta { color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
.orb-stage--alpha { color: #8a7dff; background-color: rgba(138, 125, 255, 0.14); }
.orb-stage--experimental { color: #ffb020; background-color: rgba(255, 176, 32, 0.14); }
