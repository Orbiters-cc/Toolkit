.orbiters-budget { flex-direction: column; }
.orbiters-budget__bar { flex-direction: row; height: 14px; border-radius: 7px; overflow: hidden; background-color: #333333; }
.orbiters-budget__segment { width: 0; height: 100%; }
.orbiters-budget__legend { flex-direction: column; margin-top: 8px; }
.orbiters-budget__row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.orbiters-budget__swatch { width: 10px; height: 10px; border-radius: 3px; margin-right: 8px; flex-shrink: 0; }
.orbiters-budget__label { font-size: 11px; color: #cccccc; white-space: normal; flex-shrink: 1; }
/* Inline legend: small chips in one wrapping row, under a thinner bar. */
.orbiters-budget--inline .orbiters-budget__bar { height: 10px; border-radius: 5px; }
.orbiters-budget--inline .orbiters-budget__legend { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.orbiters-budget--inline .orbiters-budget__row { margin: 0 14px 2px 0; }
.orbiters-budget--inline .orbiters-budget__swatch { width: 8px; height: 8px; border-radius: 4px; margin-right: 6px; }
.orbiters-budget--inline .orbiters-budget__label { font-size: 11px; color: #b0b0b0; white-space: nowrap; }
