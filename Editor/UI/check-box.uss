.orbiters-check { width: 16px; height: 16px; flex-shrink: 0; border-radius: 5px; background-color: #3a3a3a; cursor: link; transition-property: background-color; transition-duration: 0.12s; }
.orbiters-check:hover { background-color: #474747; }
.orbiters-check:focus { border-width: 1px; border-color: rgba(0, 218, 109, 0.5); }
.orbiters-check__mark { position: absolute; left: 2px; top: 2px; width: 12px; height: 12px; --icon-color: #06140c; opacity: 0; scale: 0.6 0.6; transition-property: opacity, scale; transition-duration: 0.12s, 0.18s; transition-timing-function: ease-out, ease-out-back; }
.orbiters-check--on { background-color: #00DA6D; }
.orbiters-check--on:hover { background-color: #19e27d; }
.orbiters-check--on .orbiters-check__mark { opacity: 1; scale: 1 1; }
.orbiters-check:disabled { opacity: 0.4; }
