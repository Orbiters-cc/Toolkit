/* Photoshoot panel shared by Orbiters tools (MCB asset media, My Avatar thumbnails). */

.ps-panel {
    margin-bottom: 14px;
}

.ps-panel Button {
    margin: 0;
    border-width: 0;
    -unity-font-style: normal;
    transition-property: background-color, border-color, color, scale, opacity;
    transition-duration: 0.14s, 0.14s, 0.14s, 0.2s, 0.14s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out-back, ease-out;
}

.ps-panel Button.ps-pressed {
    scale: 0.94 0.94;
}

.ps-panel Button:disabled {
    opacity: 0.45;
}

/* ---- Back ---------------------------------------------------------------------------------------- */

.ps-panel .ps-back {
    align-self: flex-start;
    height: 28px;
    padding-left: 12px;
    padding-right: 14px;
    margin-bottom: 12px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    color: #d9d9d9;
    font-size: 12px;
}

.ps-panel .ps-back:hover:enabled {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
}

/* ---- Stage --------------------------------------------------------------------------------------- */

.ps-stage {
    position: relative;
    height: 240px;
    margin-bottom: 10px;
    border-radius: 16px;
    overflow: hidden;
    background-color: #161616;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.ps-stage__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps-stage__tile {
    position: absolute;
    left: 14px;
    bottom: 14px;
    border-radius: 12px;
    overflow: hidden;
    background-color: #161616;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
}

.ps-tag {
    position: absolute;
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: rgba(10, 10, 10, 0.62);
    color: #f2f2f2;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.4px;
}

.ps-tag--banner {
    left: 12px;
    top: 12px;
}

.ps-tag--tile {
    left: 6px;
    top: 6px;
}

/* ---- Cards --------------------------------------------------------------------------------------- */

.ps-card {
    margin-bottom: 10px;
    padding: 12px 14px 12px 14px;
    border-radius: 14px;
    background-color: #242424;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.ps-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.ps-card__title {
    color: #f2f2f2;
    font-size: 12px;
    -unity-font-style: bold;
}

.ps-caption {
    color: #8f8f8f;
    font-size: 11px;
    white-space: normal;
}

.ps-link {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0);
    color: #9a9a9a;
    font-size: 11px;
}

.ps-panel .ps-link:hover:enabled {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

/* ---- Shots --------------------------------------------------------------------------------------- */

.ps-shots {
    padding-top: 6px;
    padding-bottom: 6px;
}

.ps-shot {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.ps-shot--divided {
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
}

.ps-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    background-color: #5c5c5c;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.ps-dot--set {
    background-color: #00DA6D;
}

.ps-shot__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ps-shot__title {
    color: #f2f2f2;
    font-size: 12px;
    -unity-font-style: bold;
}

.ps-shot__detail {
    color: #8f8f8f;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ps-pill {
    height: 28px;
    min-width: 76px;
    margin-left: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #3a3a3a;
    color: #ffffff;
    font-size: 12px;
}

.ps-panel .ps-pill {
    margin-left: 6px;
}

.ps-panel .ps-pill:hover:enabled {
    background-color: #474747;
}

.ps-pill--accent {
    background-color: #00DA6D;
    color: #0b0b0b;
    -unity-font-style: bold;
}

.ps-panel .ps-pill--accent {
    -unity-font-style: bold;
}

.ps-panel .ps-pill--accent:hover:enabled {
    background-color: #1ee684;
}

.ps-pill--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    color: #d9d9d9;
}

.ps-panel .ps-pill--ghost {
    border-width: 1px;
}

.ps-panel .ps-pill--ghost:hover:enabled {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.28);
}

.ps-message {
    margin-top: 2px;
    margin-bottom: 6px;
    color: #a9b6c2;
    font-size: 11px;
    white-space: normal;
}

.ps-message--error {
    color: #ff8c59;
}

/* ---- Framing ------------------------------------------------------------------------------------- */

.ps-framing__presets {
    margin-bottom: 10px;
}

.ps-framing__tip {
    margin-top: 6px;
    margin-left: 2px;
}

/* Direct framing on a preview (the stage, or a host element such as My Avatar's card image). */

.ps-surface {
    cursor: move-arrow;
}

.ps-surface--turning {
    cursor: rotate-arrow;
}

.ps-surface__hint {
    position: absolute;
    left: 50%;
    bottom: 8px;
    padding: 3px 9px 3px 9px;
    white-space: nowrap;
    border-radius: 10px;
    background-color: rgba(8, 9, 12, 0.72);
    color: #e6e6e6;
    font-size: 10px;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: -50% 4px;
    transition-property: opacity, translate;
    transition-duration: 0.18s, 0.24s;
    transition-timing-function: ease-out, ease-out-back;
}

.ps-surface:hover .ps-surface__hint {
    opacity: 1;
    translate: -50% 0;
}

.ps-surface--dragging .ps-surface__hint,
.ps-surface--dragging:hover .ps-surface__hint {
    opacity: 0;
}

/* ---- Style picker -------------------------------------------------------------------------------- */

.ps-style__caption {
    margin-top: 10px;
    margin-bottom: 8px;
    margin-left: 2px;
}

.ps-style__content {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.28s;
    transition-timing-function: ease-out, ease-out-back;
}

.ps-style__content--entering {
    opacity: 0;
    translate: 0 6px;
    transition-duration: 0s, 0s;
}

.ps-grid {
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 0;
}

.ps-swatch {
    width: 58px;
    height: 58px;
    margin: 0 8px 8px 0;
    padding: 0;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: #2f2f2f;
    overflow: hidden;
}

.ps-panel .ps-swatch {
    margin: 0 8px 8px 0;
    border-width: 2px;
}

.ps-panel .ps-swatch:hover:enabled {
    background-color: #3a3a3a;
    border-color: rgba(255, 255, 255, 0.22);
    scale: 1.04 1.04;
}

.ps-swatch--selected,
.ps-panel .ps-swatch--selected:hover:enabled {
    border-color: #00DA6D;
    background-color: #2f2f2f;
}

.ps-swatch--background {
    width: 84px;
    height: 58px;
}

.ps-swatch__content {
    flex-grow: 1;
    border-radius: 11px;
}

.ps-swatch__empty {
    background-color: #1a1a1a;
}

.ps-chip {
    height: 26px;
    margin: 0 6px 6px 0;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: #1f1f1f;
    color: #d0d0d0;
    font-size: 11px;
}

.ps-panel .ps-chip {
    margin: 0 6px 6px 0;
    border-width: 1px;
}

.ps-panel .ps-chip:hover:enabled {
    background-color: #2c2c2c;
    border-color: rgba(255, 255, 255, 0.28);
}

.ps-chip--selected,
.ps-panel .ps-chip--selected:hover:enabled {
    background-color: rgba(0, 218, 109, 0.16);
    border-color: #00DA6D;
    color: #ffffff;
}

/* The user's own backgrounds and poses: an add swatch, a remove button on hover, and the grid lighting up under drops. */
.ps-panel .ps-swatch--add {
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
}

.ps-panel .ps-swatch--add:hover:enabled {
    background-color: rgba(0, 218, 109, 0.08);
    border-color: rgba(0, 218, 109, 0.5);
}

.ps-swatch__add-icon {
    width: 18px;
    height: 18px;
    --icon-color: #8f8f8f;
}

.ps-panel .ps-swatch--add:hover .ps-swatch__add-icon {
    --icon-color: #00DA6D;
}

.ps-swatch-wrap {
    position: relative;
    margin: 0 8px 8px 0;
}

.ps-panel .ps-swatch-wrap > .ps-swatch {
    margin: 0;
}

.ps-panel .ps-swatch__remove {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    min-width: 0;
    padding: 4px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    background-color: #2a2a2a;
    opacity: 0;
}

.ps-swatch-wrap:hover .ps-swatch__remove {
    opacity: 1;
}

.ps-panel .ps-swatch__remove:hover:enabled {
    background-color: #ff6b6b;
    border-color: #ff6b6b;
}

.ps-swatch__remove-icon {
    flex-grow: 1;
    --icon-color: #e6e6e6;
}

.ps-panel .ps-swatch__remove:hover .ps-swatch__remove-icon {
    --icon-color: #1a0505;
}

.ps-grid--drop {
    border-radius: 14px;
    background-color: rgba(0, 218, 109, 0.06);
}

/* ---- Foldable cards (framing) ------------------------------------------------------------------- */

.ps-card--foldable > .ps-card__header {
    cursor: link;
}

.ps-card__chevron {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    --icon-color: #8f8f8f;
    rotate: 90deg;
    transition-property: rotate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.ps-card--folded .ps-card__chevron {
    rotate: 0deg;
}

.ps-card--foldable > .ps-card__header > .ps-card__title {
    flex-grow: 1;
}

.ps-card--folded > .ps-card__header {
    margin-bottom: 0;
}

/* ---- Effects: a switch, the name, the strength ----------------------------------------------------- */

.ps-grid--effects {
    flex-direction: column;
    flex-wrap: nowrap;
}

.ps-effect {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 2px 0 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.ps-effect__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
    color: #9a9a9a;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition-property: color;
    transition-duration: 0.15s;
}

.ps-effect--on .ps-effect__name {
    color: #f2f2f2;
}

.ps-effect--sub {
    margin-left: 22px;
    height: 28px;
}

.ps-effect--sub .ps-effect__name {
    font-size: 10px;
}

.ps-light__ambient {
    margin-top: 6px;
    border-bottom-width: 0;
}

.ps-light__ambient .ps-effect__name {
    margin-left: 0;
}

.ps-effect__slider {
    width: 118px;
    height: 20px;
    flex-shrink: 0;
    margin-left: 8px;
    --track-color: #333333;
    --fill-color: #00DA6D;
}

.ps-effect__slider:disabled {
    opacity: 0.32;
}

.ps-effect__value {
    width: 36px;
    flex-shrink: 0;
    margin-left: 6px;
    color: #6f6f6f;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.ps-effect--on .ps-effect__value {
    color: #bdbdbd;
}

/* ---- Colour picker ------------------------------------------------------------------------------- */

.ps-picker {
    margin-top: 4px;
    padding: 10px;
    border-radius: 12px;
    background-color: #1c1c1c;
}

.ps-picker__area {
    position: relative;
    height: 112px;
    border-radius: 9px;
    overflow: hidden;
    cursor: move-arrow;
}

.ps-picker__hue {
    position: relative;
    height: 12px;
    margin-top: 10px;
    border-radius: 6px;
    overflow: hidden;
    cursor: resize-horizontal;
}

.ps-picker__knob {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: #ffffff;
}

.ps-picker__knob--hue {
    top: -1px;
}

.ps-picker__footer {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
}

.ps-picker__swatches {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-picker__swatch {
    width: 18px;
    height: 18px;
    margin: 2px 6px 2px 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    transition-property: scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.ps-picker__swatch:hover {
    scale: 1.18 1.18;
}

.ps-picker__entry {
    flex-direction: row;
    align-items: center;
}

.ps-picker__hex {
    width: 76px;
    margin: 0 4px 0 0;
}

.ps-picker__hex .unity-base-text-field__input,
.ps-picker__hex .unity-text-field__input {
    height: 22px;
    padding-left: 8px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: #151515;
    color: #e6e6e6;
    font-size: 11px;
}

/* Look at the camera: a switch, then the head-to-eyes balance while it is on. */

.ps-look {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    margin-top: 2px;
}

.ps-look__label {
    color: #bdbdbd;
    font-size: 11px;
}

/* ---- Ref sheet ----------------------------------------------------------------------------------- */

.ps-stage--refsheet {
    background-color: #111111;
}

.ps-shot__icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    --icon-color: #00DA6D;
}

.ps-refsheet__side {
    width: 168px;
}

/* A capture flashes the sheet like a camera. */
.ps-stage__flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #ffffff;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}

.ps-stage__flash--on {
    opacity: 0.55;
    transition-duration: 0s;
}

.ps-surface--vertical {
    cursor: resize-vertical;
}

/* The sphere beside zoom and look: one row, no empty column. */

.ps-framing__body {
    flex-direction: row;
    align-items: center;
}

.ps-framing__orbit {
    margin-right: 16px;
    margin-left: 2px;
}

.ps-framing__controls {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.ps-framing__controls .orb-dial__value {
    width: 58px;
    min-width: 58px;
}

/* ---- The thumbnail's line of text: on the preview, and its Text tab ---------------------------------- */

.ps-text-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps-text {
    position: absolute;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0);
    cursor: move-arrow;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.ps-text:hover,
.ps-text--moving,
.ps-text--resizing {
    border-color: rgba(255, 255, 255, 0.55);
    background-color: rgba(255, 255, 255, 0.04);
}

.ps-text--editing {
    opacity: 0;
}

.ps-text__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps-text__handle {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: #ffffff;
    background-color: #00DA6D;
    cursor: resize-up-left;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
}

.ps-text:hover .ps-text__handle,
.ps-text--resizing .ps-text__handle {
    opacity: 1;
    scale: 1 1;
}

.ps-text__remove {
    position: absolute;
    right: -7px;
    top: -7px;
    width: 16px;
    height: 16px;
    min-width: 0;
    margin: 0;
    padding: 3px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(18, 19, 24, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.ps-text:hover .ps-text__remove {
    opacity: 1;
}

.ps-text__remove:hover {
    background-color: #ff6b6b;
}

.ps-text__remove-icon {
    flex-grow: 1;
    --icon-color: #ffffff;
}

.ps-text--moving .ps-text__remove,
.ps-text--resizing .ps-text__remove {
    opacity: 0;
}

.ps-text-add {
    position: absolute;
    left: 50%;
    top: 8px;
    height: 22px;
    margin: 0;
    padding: 0 10px 0 9px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(8, 9, 12, 0.72);
    color: #ffffff;
    font-size: 10px;
    -unity-font-style: bold;
    translate: -50% -4px;
    opacity: 0;
    transition-property: opacity, translate, background-color;
    transition-duration: 0.18s, 0.24s, 0.12s;
    transition-timing-function: ease-out, ease-out-back, ease-out;
}

.ps-surface:hover .ps-text-add {
    opacity: 1;
    translate: -50% 0;
}

.ps-text-add:hover {
    background-color: rgba(0, 218, 109, 0.85);
    border-color: rgba(0, 218, 109, 1);
}

.ps-surface--dragging .ps-text-add,
.ps-surface--dragging:hover .ps-text-add {
    opacity: 0;
}

.ps-text-guide {
    position: absolute;
    background-color: rgba(0, 218, 109, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.ps-text-guide--x {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
}

.ps-text-guide--y {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
}

.ps-text-guide--on {
    opacity: 1;
}

.ps-text-editor {
    position: absolute;
    margin: 0;
    padding: 0;
}

.ps-text-editor > .unity-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0.25);
    -unity-text-align: middle-center;
    color: inherit;
    font-size: inherit;
    --unity-cursor-color: #00DA6D;
}

.ps-text-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.ps-text-line__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.ps-text-line__field > .unity-text-field__input {
    height: 34px;
    padding: 0 12px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 13px;
}

.ps-text-line__field:focus > .unity-text-field__input {
    border-color: #00DA6D;
}

.ps-text-line__placeholder {
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    color: #6f6f6f;
    font-size: 13px;
}

.ps-text-line__clear {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    min-width: 0;
    margin: 0 0 0 6px;
    padding: 7px;
    border-radius: 13px;
    border-width: 0;
    background-color: #262626;
}

.ps-text-line__clear:hover {
    background-color: #3a3a3a;
}

.ps-text-line__clear-icon {
    flex-grow: 1;
    --icon-color: #9a9a9a;
}

.ps-text-heading {
    margin: 6px 0 6px 2px;
    color: #8c8c8c;
    font-size: 10px;
    -unity-font-style: bold;
}

.ps-grid--fonts {
    margin-bottom: 4px;
}

.ps-font {
    width: 31%;
    height: 58px;
    margin: 0 2% 8px 0;
    padding: 4px 6px 4px 6px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: #2a2a2a;
    justify-content: center;
    overflow: hidden;
}

.ps-panel .ps-font {
    margin: 0 2% 8px 0;
}

.ps-panel .ps-text-look {
    margin: 0 2% 8px 0;
}

.ps-panel .ps-font:hover:enabled {
    background-color: #343434;
    border-color: rgba(255, 255, 255, 0.22);
    scale: 1.04 1.04;
}

.ps-font--selected,
.ps-panel .ps-font--selected:hover:enabled {
    border-color: #00DA6D;
    background-color: rgba(0, 218, 109, 0.1);
}

.ps-font__sample {
    margin: 0;
    padding: 0;
    color: #ffffff;
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ps-font__name {
    margin: 2px 0 0 0;
    padding: 0;
    color: #8c8c8c;
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ps-text-look {
    width: 22.5%;
    height: 64px;
    margin: 0 2% 8px 0;
    padding: 4px;
    flex-direction: column;
    justify-content: center;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: #3b3e46;
    align-items: center;
}

.ps-panel .ps-text-look:hover:enabled {
    border-color: rgba(255, 255, 255, 0.22);
    scale: 1.04 1.04;
}

.ps-text-look--selected,
.ps-panel .ps-text-look--selected:hover:enabled {
    border-color: #00DA6D;
}

.ps-text-look__preview {
    width: 64px;
    height: 34px;
}

.ps-text-look__name {
    margin: 2px 0 0 0;
    padding: 0;
    color: #e6e6e6;
    font-size: 9px;
}

.ps-text-colors {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.ps-text-color {
    width: 24px;
    height: 24px;
    min-width: 0;
    margin: 0 6px 6px 0;
    padding: 0;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.14);
}

.ps-panel .ps-text-color:hover:enabled {
    scale: 1.12 1.12;
    border-color: rgba(255, 255, 255, 0.5);
}

.ps-text-color--selected,
.ps-panel .ps-text-color--selected:hover:enabled {
    border-color: #00DA6D;
    border-width: 3px;
}

.ps-text-size {
    margin-top: 8px;
}

/* ---- Two columns once the panel is wide: the shot and its framing, then its style beside them ---- */

.ps-panel--wide {
    flex-direction: row;
    align-items: flex-start;
}

.ps-panel--wide > .ps-column--main {
    width: 50%;
    max-width: 600px;
    flex-shrink: 0;
    margin-right: 12px;
}

.ps-panel--wide > .ps-column--style {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
