/* Follow body blendshapes: the Orbiters inspector look. */
.orbiters-follow { padding: 6px 2px 8px 2px; }
.orbiters-follow .unity-label { margin: 0; padding: 0; }
.orbiters-follow .orbiters-follow__head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.orbiters-follow .orbiters-follow__title { color: #f2f2f2; font-size: 13px; -unity-font-style: bold; margin-right: 6px; }
.orbiters-follow .orbiters-follow__text { margin-bottom: 8px; color: #9a9a9a; font-size: 11px; white-space: normal; }
.orbiters-follow .orbiters-follow__check { height: 26px; min-height: 26px; margin: 8px 0 0 0; border-width: 0; border-radius: 13px; background-color: #00da6d; color: #06140c; -unity-font-style: bold; transition-property: scale, background-color; transition-duration: 0.1s; }
.orbiters-follow .orbiters-follow__check:hover { background-color: #19e27d; }
.orbiters-follow .orbiters-follow__check--pressed { scale: 0.96 0.96; }
.orbiters-follow .orbiters-follow__results { margin-top: 8px; }
.orbiters-follow .orbiters-follow__card { margin-top: 5px; padding: 7px 10px; border-radius: 9px; background-color: #2a2a2a; opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.2s; transition-timing-function: ease-out; }
.orbiters-follow .orbiters-follow__card--enter { opacity: 0; translate: 0 6px; }
.orbiters-follow .orbiters-follow__card-title { color: #eef4ff; font-size: 12px; -unity-font-style: bold; cursor: link; }
.orbiters-follow .orbiters-follow__line { margin-top: 2px; color: #d0d0d0; font-size: 11px; }
.orbiters-follow .orbiters-follow__line--muted { margin-top: 2px; color: #8c8c8c; font-size: 11px; white-space: normal; }
.orbiters-follow .orbiters-follow__line--warning { margin-top: 2px; color: #ffb020; font-size: 11px; white-space: normal; }
