.orb-avatar-budget { flex-direction: column; }
.orb-avatar-budget__legend { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.orb-avatar-budget__key { flex-direction: row; align-items: center; margin: 0 14px 2px 0; }
.orb-avatar-budget__swatch { width: 8px; height: 8px; border-radius: 4px; margin-right: 6px; }
.orb-avatar-budget__key-label { font-size: 11px; color: #b0b0b0; margin: 0; padding: 0; }

.orb-avatar-budget__metric { margin-top: 12px; }
.orb-avatar-budget__head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.orb-avatar-budget__name { flex-grow: 1; font-size: 12px; -unity-font-style: bold; color: #e6e6e6; margin: 0; padding: 0; }
.orb-avatar-budget__value { font-size: 13px; -unity-font-style: bold; color: #ffffff; margin: 0 0 0 0; padding: 0; }
.orb-avatar-budget__unit { font-size: 11px; color: #8c8c8c; margin: 0 0 0 5px; padding: 0; }
.orb-avatar-budget__chip { margin: 0 0 0 8px; padding: 1px 8px; border-radius: 9px; font-size: 10px; -unity-font-style: bold; }
.orb-avatar-budget__chip--good { color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
.orb-avatar-budget__chip--medium { color: #e8cf5a; background-color: rgba(232, 207, 90, 0.13); }
.orb-avatar-budget__chip--poor { color: #ffb020; background-color: rgba(255, 176, 32, 0.14); }
.orb-avatar-budget__chip--very-poor { color: #ff6b6b; background-color: rgba(255, 107, 107, 0.14); }

.orb-avatar-budget__track { flex-direction: row; height: 8px; border-radius: 4px; overflow: hidden; background-color: #333333; }
.orb-avatar-budget__segment { height: 100%; flex-shrink: 0; }
.orb-avatar-budget__tick { position: absolute; top: 0; bottom: 0; width: 1px; background-color: rgba(0, 0, 0, 0.6); }
.orb-avatar-budget__hint { margin: 4px 0 0 0; padding: 0; font-size: 10px; color: #8c8c8c; white-space: normal; }

/* Parameters lead: a larger figure and bar. */
.orb-avatar-budget__metric--large { margin-top: 6px; }
.orb-avatar-budget__metric--large .orb-avatar-budget__value { font-size: 20px; }
.orb-avatar-budget__metric--large .orb-avatar-budget__track { height: 10px; border-radius: 5px; }

.orb-avatar-budget__note { margin: 14px 0 0 0; padding: 10px 0 0 0; border-top-width: 1px; border-color: #2e2e2e; font-size: 11px; color: #9a9a9a; white-space: normal; }
