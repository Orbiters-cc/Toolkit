/* Avatar budget overlay: compact, over a see-through frame (set in code on the overlay). A soft shadow keeps text
   readable over bright scenes. */
.orb-avatar-budget { flex-direction: column; width: 196px; padding: 0 1px 2px 1px; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85); }
.orb-avatar-budget__avatar { margin: 0 0 2px 0; padding: 0; font-size: 10px; -unity-font-style: bold; color: #f0f0f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.orb-avatar-budget__legend { flex-direction: row; flex-wrap: wrap; }
.orb-avatar-budget__key { flex-direction: row; align-items: center; margin: 0 10px 0 0; }
.orb-avatar-budget__swatch { width: 6px; height: 6px; border-radius: 3px; margin-right: 4px; }
.orb-avatar-budget__key-label { font-size: 9px; color: #d0d0d0; margin: 0; padding: 0; }

.orb-avatar-budget__metric { margin-top: 5px; }
.orb-avatar-budget__head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.orb-avatar-budget__name { flex-grow: 1; font-size: 10px; -unity-font-style: bold; color: #ececec; margin: 0; padding: 0; }
.orb-avatar-budget__value { font-size: 11px; -unity-font-style: bold; color: #ffffff; margin: 0 0 0 4px; padding: 0; }
.orb-avatar-budget__unit { font-size: 9px; color: #c0c0c0; margin: 0 0 0 3px; padding: 0; }
.orb-avatar-budget__chip { margin: 0 0 0 5px; padding: 0 5px; border-radius: 7px; font-size: 8px; -unity-font-style: bold; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.orb-avatar-budget__chip--good { color: #00DA6D; background-color: rgba(0, 0, 0, 0.45); }
.orb-avatar-budget__chip--medium { color: #e8cf5a; background-color: rgba(0, 0, 0, 0.45); }
.orb-avatar-budget__chip--poor { color: #ffb020; background-color: rgba(0, 0, 0, 0.45); }
.orb-avatar-budget__chip--very-poor { color: #ff6b6b; background-color: rgba(0, 0, 0, 0.45); }

.orb-avatar-budget__track { flex-direction: row; height: 4px; border-radius: 2px; overflow: hidden; background-color: rgba(0, 0, 0, 0.4); }
.orb-avatar-budget__segment { height: 100%; flex-shrink: 0; }
.orb-avatar-budget__tick { position: absolute; top: 0; bottom: 0; width: 1px; background-color: rgba(0, 0, 0, 0.75); }
.orb-avatar-budget__hint { margin: 2px 0 0 0; padding: 0; font-size: 8px; color: #d0d0d0; white-space: normal; }

/* Parameters lead: a larger figure and bar. */
.orb-avatar-budget__metric--large { margin-top: 3px; }
.orb-avatar-budget__metric--large .orb-avatar-budget__value { font-size: 13px; }
.orb-avatar-budget__metric--large .orb-avatar-budget__track { height: 5px; border-radius: 2px; }

.orb-avatar-budget__note { margin: 4px 0 0 0; padding: 0; font-size: 8px; color: #d0d0d0; white-space: normal; }
