.mcb-header {
    position: relative;
    overflow: visible;
    background-color: rgba(0,0,0,0);
}

.mcb-banner {
    background-color: rgba(0,0,0,0);
    min-height: 182px;
    justify-content: center;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 0;
    position: relative;
}

.mcb-logo {
    width: 460px;
    height: 170px;
    flex-shrink: 1;
    overflow: visible;
}

